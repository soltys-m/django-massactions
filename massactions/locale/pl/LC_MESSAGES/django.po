#, python-format
msgid "Process objects of type: %s"
msgstr "Przetwórz obiekty typu: %s"

msgid "Not possible to process any of the selected objects."
msgstr "Nie można przetworzyć żadnego z wybranych obiektów."

msgid "Delete"
msgstr "Usuń"

#, python-format
msgid "Delete objects of type: %s"
msgstr "Usuń obiekty typu: %s"

msgid ""
"Deleting the selected objects requires deleting the following related "
"objects:"
msgstr ""
"Usunięcie wybranych obiektów wymaga usunięcia następujących powiązanych "
"obiektów:"

#, python-format
msgid "Are you sure you want to delete %(count)d object?"
msgid_plural "Are you sure you want to delete %(count)d objects?"
msgstr[0] "Czy na pewno chcesz usunąć %(count)d obiekt?"
msgstr[1] "Czy na pewno chcesz usunąć %(count)d obiekty?"
msgstr[2] "Czy na pewno chcesz usunąć %(count)d obiektów?"
msgstr[3] "Czy na pewno chcesz usunąć %(count)d obiekty?"

msgid "Update"
msgstr "Aktualizuj"

#, python-format
msgid "Update objects of type: %s"
msgstr "Zaktualizuj obiekty typu: %s"

#, python-format
msgid "Are you sure you want to update '%(field_name)s' of this object?"
msgid_plural ""
"Are you sure you want to update '%(field_name)s' of %(count)d objects?"
msgstr[0] "Czy na pewno chcesz zaktualizować '%(field_name)s' tego obiektu?"
msgstr[1] ""
"Czy na pewno chcesz zaktualizować '%(field_name)s' z %(count)d obiektów?"
msgstr[2] ""
"Czy na pewno chcesz zaktualizować '%(field_name)s' z %(count)d obiektów?"
msgstr[3] ""
"Czy na pewno chcesz zaktualizować '%(field_name)s' z %(count)d obiektów?"

msgid "Close"
msgstr "Zamknij"

msgid "Actions"
msgstr "Akcje"

msgid "Number of selected items"
msgstr "Liczba wybranych pozycji"

msgid "Following objects will be deleted"
msgstr "Następujące obiekty zostaną usunięte"

msgid "Following objects will be updated"
msgstr "Następujące obiekty zostaną zaktualizowane"

msgid "Following objects will be processed"
msgstr "Następujące obiekty zostaną przetworzone"

msgid "Missing permissions to delete"
msgstr "Brak uprawnień do usunięcia"

msgid "Missing permissions to update"
msgstr "Brak uprawnień do zaktualizowania"

msgid "Missing permissions to process"
msgstr "Brak uprawnień do przetwarzania"

msgid "Select"
msgstr "Wybierz"

msgid "Select visible"
msgstr "Wybierz widoczne"

msgid "Select all"
msgstr "Wybierz wszystkie"

msgid "Clear all"
msgstr "Wyczyść wszystkie"

msgctxt "url"
msgid "delete/"
msgstr "usun/"

msgctxt "url"
msgid "update/"
msgstr "aktualizuj/"

msgid "You do not have permission to perform this action."
msgstr "Nie masz uprawnień do wykonania tej czynności."

msgid "Your session has expired. Please, log in again."
msgstr "Twoja sesja wygasła. Zaloguj się ponownie."

msgid "Please, select an object first."
msgstr "Proszę najpierw wybrać obiekt."

msgid "Login required"
msgstr "Wymagane logowanie"

msgid "Permission missing"
msgstr "Brak uprawnień"

msgid "No object selected"
msgstr "Nie wybrano żadnego obiektu"

msgid ""
"Objects could not be deleted, because they are associated with other "
"objects."
msgstr ""
"Obiekty nie mogły być usunięte, ponieważ są powiązane z innymi obiektami."

#, python-format
msgid "%(count)d object was successfully deleted."
msgid_plural "%(count)d objects were successfully deleted."
msgstr[0] "%(count)d obiekt został pomyślnie usunięty."
msgstr[1] "%(count)d obiekty zostały pomyślnie usunięte."
msgstr[2] "%(count)d obiektów zostało pomyślnie usuniętych."
msgstr[3] "%(count)d obiekty zostały pomyślnie usunięte."

#, python-format
msgid "%(count)d object was successfully updated."
msgid_plural "%(count)d objects were successfully updated."
msgstr[0] "%(count)d obiekt został pomyślnie zaktualizowany."
msgstr[1] "%(count)d obiekty zostały pomyślnie zaktualizowane."
msgstr[2] "%(count)d obiektów zostało pomyślnie zaktualizowanych."
msgstr[3] "%(count)d obiekty zostały pomyślnie zaktualizowane."
